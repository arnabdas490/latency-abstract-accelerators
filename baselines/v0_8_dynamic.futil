import "primitives/core.futil";
import "primitives/memories/comb.futil";

component main() -> () {
  cells {
    @external(1) mem = comb_mem_d1(32, 4, 2);

    x = std_reg(32);
    counter = std_reg(32);
    a_out = std_reg(32);
    b_out = std_reg(32);

    add_a = std_add(32);
    add_b = std_add(32);
    add_counter = std_add(32);
    add_final = std_add(32);

    lt = std_lt(32);
    wait_a_reg = std_reg(1);
    wait_b_reg = std_reg(1);
  }

  wires {
    group load_x {
      mem.addr0 = 2'd0;
      x.in = mem.read_data;
      x.write_en = 1'b1;
      load_x[done] = x.done;
    }

    group init_counter {
      counter.in = 32'd0;
      counter.write_en = 1'b1;
      init_counter[done] = counter.done;
    }

    comb group cond {
      mem.addr0 = 2'd1;
      lt.left = counter.out;
      lt.right = mem.read_data;
    }

    group kernel_a_compute {
      add_a.left = x.out;
      add_a.right = 32'd1;

      a_out.in = add_a.out;
      a_out.write_en = 1'b1;
      kernel_a_compute[done] = a_out.done;
    }

    group kernel_b_compute {
      add_b.left = x.out;
      add_b.right = 32'd2;

      b_out.in = add_b.out;
      b_out.write_en = 1'b1;
      kernel_b_compute[done] = b_out.done;
    }

    group incr_counter {
      add_counter.left = counter.out;
      add_counter.right = 32'd1;

      counter.in = add_counter.out;
      counter.write_en = 1'b1;
      incr_counter[done] = counter.done;
    }

    group kernel_wait_a {
      wait_a_reg.in = wait_a_reg.out;
      wait_a_reg.write_en = 1'b1;
      kernel_wait_a[done] = wait_a_reg.done;
    }

    group kernel_wait_b {
      wait_b_reg.in = wait_b_reg.out;
      wait_b_reg.write_en = 1'b1;
      kernel_wait_b[done] = wait_b_reg.done;
    }

    group write_result {
      add_final.left = a_out.out;
      add_final.right = b_out.out;

      mem.addr0 = 2'd2;
      mem.write_data = add_final.out;
      mem.write_en = 1'b1;

      write_result[done] = mem.done;
    }
  }

  control {
    seq {
      load_x;
      init_counter;

      while lt.out with cond {
        seq {
          par {
            seq {
          repeat 1 {
            kernel_wait_a;
          }
          kernel_a_compute;
            }

            seq {
          repeat 4 {
            kernel_wait_b;
          }
          kernel_b_compute;
            }
          }

          incr_counter;
        }
      }

      write_result;
    }
  }
}
